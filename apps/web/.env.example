# apps/web — client environment (docs/PROJECT_PLAN.md §7.1)
#
# Copy to `apps/web/.env` and fill in. `.env` is gitignored; this template
# is the only tracked copy and must never contain a real value.
#
#   cp apps/web/.env.example apps/web/.env
#
# ONLY `VITE_PUBLIC_`-prefixed variables may appear in this file.
# Everything here is compiled into the public JavaScript bundle and is
# readable by anyone who loads the site — treat every value as published.
# A server-only secret in this file is a secret leak, not a config choice.
#
# Two independent locks enforce that (§7.1, docs/security/secrets-matrix.md):
#   1. packages/config/eslint-config fails lint on any non-VITE_PUBLIC_
#      `import.meta.env` / `process.env` access under apps/web/src.
#   2. Vite refuses to inline non-VITE_-prefixed vars into the bundle.

# Base URL of the apps/api Worker. Local dev default shown; set to the
# deployed Worker origin in Cloudflare Pages build settings.
VITE_PUBLIC_API_BASE_URL=http://localhost:8787

# Supabase project URL + anon key. Public by design — the real access
# gate is Row Level Security, not secrecy of the anon key (§4.1).
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile SITE key (widget render only). The matching
# TURNSTILE_SECRET_KEY is server-only and lives in apps/api/.dev.vars.
VITE_PUBLIC_TURNSTILE_SITE_KEY=

# Mapbox token — must be domain-restricted and read-only scoped.
VITE_PUBLIC_MAPBOX_TOKEN=

# Public half of the VAPID keypair, used by the browser to register a Web
# Push subscription. The private half never reaches any deployed app.
VITE_PUBLIC_VAPID_PUBLIC_KEY=
