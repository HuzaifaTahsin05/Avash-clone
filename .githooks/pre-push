#!/bin/sh
# Layer 3 (docs/standards/agent-compliance.md) — the single highest-value
# hook here: the promotion-path violation it prevents (a feature branch or
# a force-push reaching a remote) is the one that is most annoying to
# undo. docs/standards/git-workflow.md § Hard rule: the promotion path.
#
# POSIX sh: this repo is developed on Windows via Git Bash.

remote_name="$1"
zero="0000000000000000000000000000000000000000"

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a delete — nothing to enforce here

  branch=$(printf '%s\n' "$remote_ref" | sed -n 's#^refs/heads/##p')
  [ -z "$branch" ] && continue # not a branch push (e.g. a tag)

  # Only "dev" and "main" may ever reach a remote.
  if [ "$branch" != "dev" ] && [ "$branch" != "main" ]; then
    echo "pre-push: refusing to push \"$branch\" — feature branches are local-only."
    echo "  See docs/standards/git-workflow.md § Hard rule: the promotion path."
    fail=1
    continue
  fi

  # Refuse a force-push: the remote tip must be an ancestor of what's being
  # pushed, i.e. this must be a fast-forward.
  if [ "$remote_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "pre-push: refusing to force-push \"$branch\" — history would be destroyed."
      echo "  See docs/standards/git-workflow.md § Hard rule: the promotion path."
      fail=1
      continue
    fi
  fi

  # Only "dev" may ever be pushed to a remote named "upstream".
  if [ "$remote_name" = "upstream" ] && [ "$branch" != "dev" ]; then
    echo "pre-push: refusing to push \"$branch\" to \"upstream\" — only \"dev\" reaches upstream directly."
    echo "  See docs/standards/git-workflow.md § Hard rule: the promotion path."
    fail=1
  fi
done

exit $fail
